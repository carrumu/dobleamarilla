{
  "functions": {
    "api/*.js": {
      "includeFiles": "lib/{manifest,catalogo}.js",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(panel|pedido)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
