# Hostinger (Apache/LiteSpeed). HTML, JS y CSS sin caché para que cada cambio se vea al momento.
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico|woff2?|glb)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Modelo 3D del configurador
AddType model/gltf-binary .glb

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json model/gltf-binary
</IfModule>

# Fuerza HTTPS y la dirección con www, igual que en Vercel: https://www.dobleeamarilla.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^dobleeamarilla\.com$ [NC]
  RewriteRule ^ https://www.dobleeamarilla.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Archivos que no deben verse desde fuera
<FilesMatch "(?i)(^\.|\.(md|bak|log|sh|py|zip)$)">
  Require all denied
</FilesMatch>

ErrorDocument 404 /index.html
